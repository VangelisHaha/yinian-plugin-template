{
  "manifestVersion": 1,
  "id": "yinian-plugin-template",
  "name": "插件模板",
  "version": "0.2.0",
  "author": "vangelis",
  "description": "一念插件官方模板：通用 AI 工具与各扩展点的可运行示例",
  "homepage": "https://github.com/VangelisHaha/yinian-plugin-template",
  "minHostVersion": "0.13.0",
  "runtime": {
    "kind": "process",
    "node": ">=20",
    "entry": {
      "default": "dist/main.mjs"
    }
  },
  "permissions": {
    "net": [],
    "spawn": [],
    "fs": [],
    "api": []
  },
  "contributes": {
    "sync": {
      "resources": [
        "task"
      ],
      "capabilities": {
        "actions": [
          "list",
          "update",
          "complete",
          "reopen",
          "cancel"
        ],
        "fields": [
          "title",
          "notes",
          "due_at",
          "priority"
        ]
      }
    },
    "syncStrategy": {
      "modes": [
        "interval",
        "manual"
      ],
      "defaultIntervalSeconds": 300,
      "minIntervalSeconds": 60
    },
    "notificationChannel": {
      "id": "template-log",
      "name": "模板通知渠道",
      "supportsActions": false
    },
    "dayMarks": {
      "providers": [
        {
          "id": "template-marks",
          "name": "模板日期标记",
          "kinds": [
            "festival"
          ]
        }
      ]
    },
    "calendarOverlay": {
      "providers": [
        {
          "id": "template-overlay",
          "name": "模板日历叠加",
          "surfaces": [
            "dayBadge",
            "summary",
            "sidebarStat"
          ],
          "description": "示例：每周六打一个角标，并汇总当前口径的天数。不读任何真实数据"
        }
      ]
    },
    "widget": {
      "providers": [
        {
          "id": "template-widget",
          "name": "模板小组件",
          "layout": "timeline",
          "description": "示例：列出今天剩下的整点时段与距现在多久。不读任何真实数据",
          "refreshSeconds": 300
        }
      ]
    },
    "hooks": [
      "task.completed",
      "task.reopened"
    ],
    "settingsPanel": [
      "settings.plugin.json",
      "settings.integration.json"
    ],
    "agentTools": {
      "scope": "integration"
    }
  },
  "authMode": [
    "token"
  ]
}
